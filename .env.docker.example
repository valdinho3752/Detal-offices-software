# Plantilla de Docker. No la edites para usarla: python scripts/preparar_docker.py crea .env.docker con claves propias.
ENV=production
DEBUG=False

# La usan tanto PostgreSQL como el backend
POSTGRES_USER=clinica
POSTGRES_PASSWORD=CAMBIAR_CLAVE_BD
POSTGRES_DB=clinica_dental
DB_USER=clinica
DB_PASSWORD=CAMBIAR_CLAVE_BD
DB_NAME=clinica_dental

SECRET_KEY=CAMBIAR_CLAVE_JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Zona horaria de la clínica. Todos los equipos muestran esta hora, aunque tengan otra configurada.
CLINICA_TIMEZONE=CAMBIAR_ZONA

# Vacío: la web y la API se sirven desde la misma dirección
CORS_ORIGINS=

# Solo con el perfil https. Dominio público o nombre del servidor en la red interna.
CLINICA_DIRECCION=localhost
# Vacío con un dominio público. En una red interna: tls internal
CLINICA_TLS=
