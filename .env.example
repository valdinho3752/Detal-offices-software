# Plantilla para producción. Cópiala como .env en el servidor y reemplaza cada valor.
ENV=production
DEBUG=False

# Base de datos. Usa una contraseña propia y larga en ambas líneas.
DB_USER=postgres
DB_PASSWORD=CAMBIAR
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clinica_dental_prod
DATABASE_URL=postgresql+psycopg2://postgres:CAMBIAR@localhost:5432/clinica_dental_prod

# Genera la clave con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CAMBIAR
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Zona horaria de la clínica. Los equipos deben tener la misma.
CLINICA_TIMEZONE=America/La_Paz

# Vacío: la web y la API se sirven desde la misma dirección con Caddy
CORS_ORIGINS=

# Solo accesible desde este equipo; Caddy recibe las conexiones externas
HOST=127.0.0.1
PORT=8000

# Carpeta de las copias de seguridad. Debe estar en otro disco o sincronizada fuera del servidor.
BACKUP_DIR=D:\RespaldosClinica
